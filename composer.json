{
  "name": "grrr-amsterdam/redirects",
  "description": "Manage website redirects from WordPress or Laravel Nova.",
  "type": "library",
  "license": "BSD-3-Clause",
  "autoload": {
    "psr-4": {
      "Grrr\\Redirects\\Nova\\": "nova-plugin/src/",
      "Grrr\\Redirects\\WordPress\\": "wordpress-plugin/src/"
    }
  },
  "authors": [
    {
      "name": "Martijn Gastkemper",
      "email": "martijn.gastkemper@grrr.nl"
    },
    {
      "name": "Harmen Janssen",
      "email": "harmen.janssen@grrr.nl"
    }
  ],
  "require": {
    "php": ">=8.0.0",
    "laravel/framework": "^8.0|^9.0|^10.0",
    "laravel/nova": "^3.0|^4.0"
  },
  "require-dev": {
    "nunomaduro/larastan": "^2.6",
    "phpstan/phpstan": "^1.10"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Grrr\\Redirects\\Nova\\ToolServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "composer",
      "url": "https://nova.laravel.com"
    }
  ],
  "scripts": {
    "static-analysis": "phpstan analyse --ansi --memory-limit 512M"
  }
}
